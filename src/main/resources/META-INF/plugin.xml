<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.avatarprogress.avatar-progress</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Avatar-progress</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/Gmatieso">Gmatieso</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <h2>🌊🔥🪨💨 Avatar Progress</h2>
        <p>
            Replaces your IDE progress bars with
            Avatar: The Last Airbender bending animations!
        </p>
        <ul>
            <li>🌊 <b>Katara</b> — Water Tribe blue</li>
            <li>🔥 <b>Zuko</b>  — Fire Nation red</li>
            <li>🪨 <b>Toph</b>  — Earth Kingdom green</li>
            <li>💨 <b>Aang</b>  — Air Nomad orange</li>
        </ul>
        <p>Configure under
        <b>Settings → Appearance and Behavior → Avatar Progress</b>
        </p>
    ]]></description>

    <idea-version since-build="233"/>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">

        <applicationService
                serviceImplementation="com.avatarprogress.settings.AvatarProgressState"
        />
        <applicationConfigurable
                parentId="appearance"
                instance="com.avatarprogress.settings.AvatarProgressConfigurable"
                id="com.avatarprogress.settings.AvatarProgressConfigurable"
                displayName="Avatar Progress"
        />
        <postStartupActivity
                implementation="com.avatarprogress.listeners.AvatarProgressListener"
        />
    </extensions>

    <actions>
        <action id="AvatarProgress.TestBar"
                class="com.avatarprogress.actions.TestProgressBarAction"
                text="Avatar Progress Diagnostic..."
                description="Show raw JProgressBar to test Avatar Progress rendering">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <applicationListeners>
        <listener
                class="com.avatarprogress.listeners.AvatarProgressListener"
                topic="com.intellij.ide.ui.LafManagerListener"
        />

        <listener
                class="com.avatarprogress.listeners.AvatarProgressListener"
                topic="com.intellij.ide.plugins.DynamicPluginListener"
        />
    </applicationListeners>

</idea-plugin>